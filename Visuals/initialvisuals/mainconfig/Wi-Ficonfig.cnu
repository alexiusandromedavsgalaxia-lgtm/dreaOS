_MAGIC3-VISUALINTERFACE(
--window (import configwindowbuttons, externalconfigdesign FROM ./welcome.cnu)
  _WI-FI-READ="739_560000130_0500023000141010028";
  _WI-FI-DRIVER="740_570000131_0500023100142010029";
  _WI-FI-CONNECT="741_580000132_0500023200143010030";
  _WI-FI-GETPASSWORD="798_115000189_0500028900200010087";
  _WI-FI-GETIP="799_115000190_0500029000201010088";
  _WI-FI-COMPROBE="800_116000191_0500029100202010089"
-text (
"& F"StyleColor:Black
*+*"• L"StyleColor:Black
*+*"CMD"StyleColor:Blue
--position(undercorner6px)
--typography(import AmericanTypewriter FROM *leterfontRepo^^ -&Use)
  )
  -background (RD-FADEINOUT.*colors="sea-blue, grass-green, light-yellow"*intDynamicBackground/day:lightColors/night:darkcolors*)
  -title(
  "Fåg êt dågs Wi-Fi"
  -titleposition(top:px:2)-CenterScreen()
  -titlecolor(dynamicColor/day:Black/night:White)
  )
  -wifindividualview (
  -interface ({
  -network-name(
  -position(topScreen:px:2)
  -color(dynamicColor/day:Black/night:White)
  GET *name
  )
  -background (RD-FADEINOUT.*colors="sea-blue, grass-green, light-yellow"*intDynamicBackground/day:lightColors/night:darkcolors*)
 .dif {
  if user ==¡ connected
  return connectWi-Fi
  else return sendPassword
    if Wi-Fi ==¡ have Password
    return connect
    else return password
  }
  -interface-noconnected(
      -network-name(
  -position(topScreen:px:2)
  -color(dynamicColor/day:Black/night:White)
    -typography(use AmericanTypewriter)
  GET *name
  )
  -background (RD-FADEINOUT.*colors="sea-blue, grass-green, light-yellow"*intDynamicBackground/day:lightColors/night:darkcolors*)
    -textimput("Ingress the password of this Wi-Fi network to connect"*.dif)
    )
  -interface-connected(
         -network-name(
  -position(topScreen:px:2)
  -color(dynamicColor/day:Black/night:White)
    -typography(use AmericanTypewriter)
  GET *name
  )
  -background (RD-FADEINOUT.*colors="sea-blue, grass-green, light-yellow"*intDynamicBackground/day:lightColors/night:darkcolors*)
    -info(
    showWi-FiInfo
    )
    )
    
  -wifilist(
    GET Wi-FiList
    .escale {
    'network1-intensity', 'network1-name', 'network1-typeaccess'
    repeat after return noDetectedMore
    }
    )
    if Wi-FiTypeaccess == "locked" asignIcon="🔒";
    else asignIcon="🔓"
      )
