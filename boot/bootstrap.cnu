_BOOTSTRAP.BOOTSTRAP [
  SSD92EDLDSS0294OSOFFFPPSSDDPPSSSLRRRRPWOEKFFO039292949
  MAGIC_HEADER_AP806090-50
  FEDINSTRUCTION_MAINBOOTSTRAP
  FEDINSTRUCTION_PROCESS.BOOTSTRAPINIT
  FEDINSTRUCTION_PROCESSMANAGER.INITFIRS ARD50./dreaOS/boot/bootstrap.cnu
]
  
  _FEDHEADER_MEMGESTION.INSTRUCTIONPLD [
  HEADER1_INSTRUCTIONBOOTSTRAP_MEM(
  GET(MEMORY, STORAGE)
 
  GET(CAPACITY, TYPE)
  )
  HEADER2_INSTRUCTIONBOOTSTRAP_RAM(
  GET(STATE, CAPACITY, TYPE)
  GET(*DATA)

  DEFAULT_HEADER1.EXPORT { Export_HEADER1 }
  DEFAULT_HEADER2.EXPORT { Export_HEADER2 }

  ]

  FEDHEADER_RAMMANAGER.INSTRUCTIONPLD [
  HEADER1_GETRAMEVENTS_BOOTSTRAP_RAM(
  GET(STATEMANAGER, THERMAL)

  DEFAULT_HEADER1.EXPORT { Export_HEADER1 } )
 
  HEADER2_GETRAMTHERMAL_BOOTSTRAP_RAM(
  GET(THERMAL, KELVIN, CELSIUS, FARENHEID)
  GET(TEMPERATURESTORY, TEMPERATURE)

  DEFAULT_HEADER2.EXPORT { Export_HEADER2 } )

  EXPORTDEFAULT.BOOTSTRAP(:dc.root)
